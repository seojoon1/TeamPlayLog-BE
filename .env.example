# 개발 기본값은 SQLite. 배포 시 PostgreSQL 주소로 바꾼다.
# (postgres:// 또는 postgresql:// 로 시작하는 주소를 그대로 넣어도 된다. Neon은 끝에 ?sslmode=require 가 붙어 있어야 한다)
DATABASE_URL=sqlite:///./teamplaylog.db
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 배포 시 반드시 32자 이상의 임의 문자열로 바꾼다. 개발용 기본값으로는 PostgreSQL에서 서버가 시작되지 않는다.
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14

# 웹 미리보기(Expo web) 주소. 안드로이드 앱만 쓸 때는 바꿀 필요 없다.
CORS_ORIGINS=["http://localhost:8081"]
